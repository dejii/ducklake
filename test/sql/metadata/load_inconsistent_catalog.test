# name: test/sql/metadata/load_inconsistent_catalog.test
# description: loading a catalog whose metadata is inconsistent reports which entry is broken
# group: [metadata]

require ducklake

require parquet

test-env DATA_PATH {TEST_DIR}

# a table that references a schema that does not exist
statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_schema.db' AS dl (DATA_PATH '{DATA_PATH}/inconsistent_schema')

statement ok
CREATE TABLE dl.t AS SELECT 1 AS i

statement ok
UPDATE __ducklake_metadata_dl.ducklake_table SET schema_id = 999

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_schema.db' AS dl

statement error
SELECT * FROM dl.t
----
table with id 1 references schema id 999 that does not exist

statement ok
DETACH dl

# a table without any columns
statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_columns.db' AS dl (DATA_PATH '{DATA_PATH}/inconsistent_columns')

statement ok
CREATE TABLE dl.t AS SELECT 1 AS i

statement ok
DELETE FROM __ducklake_metadata_dl.ducklake_column

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_columns.db' AS dl

statement error
SELECT * FROM dl.t
----
Table entry "t" does not have any columns

statement ok
DETACH dl

# a nested column whose parent column does not exist
statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_parent.db' AS dl (DATA_PATH '{DATA_PATH}/inconsistent_parent')

statement ok
CREATE TABLE dl.t (s STRUCT(a INTEGER))

statement ok
UPDATE __ducklake_metadata_dl.ducklake_column SET parent_column = 999 WHERE parent_column IS NOT NULL

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_parent.db' AS dl

statement error
SELECT * FROM dl.t
----
Could not find parent column for column a

statement ok
DETACH dl

# a view that references a schema that does not exist
statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_view_schema.db' AS dl (DATA_PATH '{DATA_PATH}/inconsistent_view_schema')

statement ok
CREATE VIEW dl.v AS SELECT 1 AS i

statement ok
UPDATE __ducklake_metadata_dl.ducklake_view SET schema_id = 999

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_view_schema.db' AS dl

statement error
SELECT * FROM dl.v
----
could not find schema that corresponds to the view entry "v"

statement ok
DETACH dl

# a struct column without child columns
statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_struct.db' AS dl (DATA_PATH '{DATA_PATH}/inconsistent_struct')

statement ok
CREATE TABLE dl.good AS SELECT 1 AS i

statement ok
CREATE TABLE dl.t (s STRUCT(a INTEGER))

statement ok
DELETE FROM __ducklake_metadata_dl.ducklake_column WHERE column_name = 'a'

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_struct.db' AS dl

statement error
SELECT * FROM dl.good
----
Structs must have at least one child entry

statement ok
DETACH dl

# a struct without child columns inside a list
statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_list_struct.db' AS dl (DATA_PATH '{DATA_PATH}/inconsistent_list_struct')

statement ok
CREATE TABLE dl.t (l STRUCT(a INTEGER)[])

statement ok
DELETE FROM __ducklake_metadata_dl.ducklake_column WHERE column_name = 'a'

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_list_struct.db' AS dl

statement error
SELECT * FROM dl.t
----
Structs must have at least one child entry

statement ok
DETACH dl

# a list column without a child column
statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_list.db' AS dl (DATA_PATH '{DATA_PATH}/inconsistent_list')

statement ok
CREATE TABLE dl.t (l INTEGER[])

statement ok
DELETE FROM __ducklake_metadata_dl.ducklake_column WHERE parent_column IS NOT NULL

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_list.db' AS dl

statement error
SELECT * FROM dl.t
----
Lists must have a single child entry

statement ok
DETACH dl

# a map column without child columns
statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_map.db' AS dl (DATA_PATH '{DATA_PATH}/inconsistent_map')

statement ok
CREATE TABLE dl.t (m MAP(INTEGER, VARCHAR))

statement ok
DELETE FROM __ducklake_metadata_dl.ducklake_column WHERE parent_column IS NOT NULL

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/inconsistent_map.db' AS dl

statement error
SELECT * FROM dl.t
----
Maps must have two child entries

statement ok
DETACH dl
